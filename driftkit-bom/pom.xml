<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Bill of Materials for DriftKit.
        Intentionally has NO parent: importing this BOM must not pull the parent's
        dependencyManagement (Spring Boot / Spring Cloud / Spring AI BOMs) into consumer projects.
        Consequences: the root `release` profile does not apply here, so gpg/central-publishing are
        redeclared below and the BOM is deployed as its own Central bundle; driftkit-parent is not
        managed by this BOM (it is only needed by projects that inherit from it). Sample modules
        (driftkit-workflows-examples-*) are deliberately not listed - they are not supported API.
        Keep the list in sync with the jar-packaged modules of the reactor (34 artifacts).
        Usage:
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>ai.driftkit</groupId>
                        <artifactId>driftkit-bom</artifactId>
                        <version>0.9.1</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
    -->
    <groupId>ai.driftkit</groupId>
    <artifactId>driftkit-bom</artifactId>
    <version>0.9.1</version>
    <packaging>pom</packaging>

    <name>DriftKit BOM</name>
    <description>Bill of Materials for all DriftKit Framework modules</description>
    <url>https://github.com/driftkit-ai/driftkit-framework</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>DriftKit AI Team</name>
            <email>alexey.doroshev@gmail.com</email>
            <organization>DriftKit AI</organization>
            <organizationUrl>https://driftkit.ai</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/driftkit-ai/driftkit-framework</url>
        <connection>scm:git:https://github.com/driftkit-ai/driftkit-framework.git</connection>
        <developerConnection>scm:git:git@github.com:driftkit-ai/driftkit-framework.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven-gpg-plugin.version>3.1.0</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.9.0</central-publishing-plugin.version>
    </properties>

